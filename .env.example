# Stormgrid operator-local environment variables (EXAMPLE / TEMPLATE).
#
# These are OPERATOR-LOCAL paths — every value below is a PLACEHOLDER.
# Never commit real machine paths. Copy this file to a local, untracked
# .env (or export the variables in your shell) and fill in your own paths.
#
# All paths are read-only inputs to the offline Python builders under
# scripts/. The builders error out clearly if the variable they need is
# unset (there is no baked-in default).

# Root of the pluvio-stormgauge working tree containing the BOM IFD cache
# and verified-station list. Consumed by scripts/build_catchment_ifd.py.
# (Builder also accepts --pluvio-root, which defaults to this variable.)
STORMGRID_PLUVIO_ROOT=<PLUVIO_ROOT>

# Council asset CSV export (read-only). Consumed by
# scripts/build_asset_snapshot.py.
# (Builder also accepts --source, which defaults to this variable.)
STORMGRID_ASSET_SOURCE=<ASSET_SOURCE_CSV>
